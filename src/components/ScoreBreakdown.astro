---
import ScoreBadge from "./ScoreBadge.astro";

interface Props {
  score: number;
  details?: { story?: number; gameplay?: number; visual?: number };
}

const { score, details } = Astro.props;
const labels = [
  ["story", "Historia"],
  ["gameplay", "Jugabilidad"],
  ["visual", "Apartado visual"],
] as const;
const scores = labels.filter(([key]) => details?.[key] !== undefined);
---

<div class="score-breakdown">
  <ScoreBadge score={score} size="lg" />
  {scores.length > 0 && (
    <dl class="details" aria-label="Subpuntuaciones de la reseña">
      {scores.map(([key, label]) => (
        <div class="detail">
          <dt>{label}</dt>
          <dd>
            <span class="bar">
              <span style={`width: ${(details?.[key] ?? 0) * 10}%`}></span>
            </span>
            <strong>{details?.[key]} / 10</strong>
          </dd>
        </div>
      ))}
    </dl>
  )}
</div>

<style>
  .score-breakdown {
    display: grid;
    gap: 0.85rem;
    justify-items: start;
  }
  .details {
    display: grid;
    gap: 0.55rem;
    width: min(100%, 270px);
    margin: 0;
  }
  .detail {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 1rem;
    align-items: center;
  }
  dt {
    color: var(--muted);
    font-size: 0.78rem;
  }
  dd {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--text);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .bar {
    width: 54px;
    height: 5px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--field);
  }
  .bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--gold);
  }
</style>

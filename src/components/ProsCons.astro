---
interface Props {
	pros?: string[];
	cons?: string[];
}

const { pros = [], cons = [] } = Astro.props;
---

{(pros.length > 0 || cons.length > 0) && (
	<section class="pros-cons" aria-label="Lo mejor y lo mejorable">
		{pros.length > 0 && (
			<div class="column pros card-panel" style="--card-radius: 0.9rem;">
				<h2>Lo mejor</h2>
				<ul>
					{pros.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</div>
		)}
		{cons.length > 0 && (
			<div class="column cons card-panel" style="--card-radius: 0.9rem;">
				<h2>Lo mejorable</h2>
				<ul>
					{cons.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</div>
		)}
	</section>
)}

<style>
	.pros-cons {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: 1rem;
		margin: 2rem 0;
	}
	.column {
		padding: 1.1rem 1.25rem;
	}
	.column h2 {
		margin: 0 0 0.65rem;
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.column ul {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding-left: 1.15rem;
		line-height: 1.6;
	}
	.pros h2,
	.pros li::marker {
		color: var(--green);
	}
	.cons h2,
	.cons li::marker {
		color: var(--red);
	}
</style>
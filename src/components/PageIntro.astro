---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="page-intro">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="description">{description}</p>
</header>

<style>
  .page-intro {
    max-width: 58rem;
    margin: clamp(1.25rem, 3vw, 2.2rem) 0 1.5rem;
    padding: 0.2rem 0 0.25rem clamp(1rem, 2.2vw, 1.5rem);
    border-left: 4px solid var(--accent);
    text-align: left;
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .description {
    max-width: 68ch;
    margin: 0.65rem 0 0;
    color: var(--muted);
    font-size: clamp(0.98rem, 1.4vw, 1.12rem);
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .page-intro {
      margin-top: 1rem;
      padding-left: 0.85rem;
    }
  }
</style>

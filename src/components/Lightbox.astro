<dialog class="lightbox" aria-label="Vista ampliada de imagen">
  <div class="lightbox-controls">
    <button class="lightbox-close" type="button" aria-label="Cerrar imagen">
      ×
    </button>
  </div>
  <div class="lightbox-stage">
    <button
      class="lightbox-nav lightbox-previous"
      type="button"
      aria-label="Imagen anterior"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m15 18-6-6 6-6" />
      </svg>
    </button>
    <img class="lightbox-image" src="" alt="" width="1200" height="800" />
    <button
      class="lightbox-nav lightbox-next"
      type="button"
      aria-label="Imagen siguiente"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </button>
  </div>
  <div class="lightbox-footer">
    <p id="lightbox-caption"></p>
    <span class="lightbox-count" aria-live="polite"></span>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
  const image = dialog?.querySelector<HTMLImageElement>(".lightbox-image");
  const caption = dialog?.querySelector<HTMLElement>("#lightbox-caption");
  const count = dialog?.querySelector<HTMLElement>(".lightbox-count");
  const closeButton =
    dialog?.querySelector<HTMLButtonElement>(".lightbox-close");
  const previousButton =
    dialog?.querySelector<HTMLButtonElement>(".lightbox-previous");
  const nextButton = dialog?.querySelector<HTMLButtonElement>(".lightbox-next");
  let triggers: HTMLElement[] = [];
  let activeIndex = 0;
  let opener: HTMLElement | null = null;
  let touchStartX: number | undefined;

  for (const inlineImage of document.querySelectorAll<HTMLImageElement>(
    ".prose img",
  )) {
    if (inlineImage.closest("[data-lightbox-trigger], a")) continue;
    const trigger = document.createElement("button");
    trigger.type = "button";
    trigger.className = "inline-lightbox-trigger";
    trigger.dataset.lightboxTrigger = "";
    trigger.dataset.lightboxGroup = "entry-media";
    trigger.dataset.lightboxSrc = inlineImage.currentSrc || inlineImage.src;
    trigger.dataset.lightboxAlt = inlineImage.alt;
    trigger.setAttribute(
      "aria-label",
      `Ampliar imagen${inlineImage.alt ? `: ${inlineImage.alt}` : ""}`,
    );
    inlineImage.before(trigger);
    trigger.append(inlineImage);
  }

  function show(index: number) {
    if (!image || triggers.length === 0) return;
    activeIndex = (index + triggers.length) % triggers.length;
    const trigger = triggers[activeIndex];
    image.src = trigger.dataset.lightboxSrc || "";
    image.alt = trigger.dataset.lightboxAlt || "";
    const text = trigger.dataset.lightboxCaption || image.alt;
    if (caption) caption.textContent = text;
    dialog?.setAttribute("aria-label", text || "Vista ampliada de imagen");
    if (count) count.textContent = `${activeIndex + 1} / ${triggers.length}`;
    if (previousButton) previousButton.hidden = triggers.length < 2;
    if (nextButton) nextButton.hidden = triggers.length < 2;
    if (triggers.length > 1) {
      const next = new Image();
      next.src =
        triggers[(activeIndex + 1) % triggers.length].dataset.lightboxSrc || "";
    }
  }

  function close() {
    if (!dialog?.open) return;
    dialog.close();
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const trigger = target.closest<HTMLElement>("[data-lightbox-trigger]");
    if (!trigger || !dialog) return;
    event.preventDefault();
    const group = trigger.dataset.lightboxGroup;
    triggers = [
      ...document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]"),
    ].filter((item) => item.dataset.lightboxGroup === group);
    opener = trigger;
    show(triggers.indexOf(trigger));
    if (!dialog.open) dialog.showModal();
    closeButton?.focus();
  });

  closeButton?.addEventListener("click", close);
  previousButton?.addEventListener("click", () => show(activeIndex - 1));
  nextButton?.addEventListener("click", () => show(activeIndex + 1));
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) close();
  });
  dialog?.addEventListener("close", () => {
    const trigger = opener;
    opener = null;
    trigger?.focus();
  });
  dialog?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      event.preventDefault();
      close();
    } else if (event.key === "ArrowLeft") {
      event.preventDefault();
      show(activeIndex - 1);
    } else if (event.key === "ArrowRight") {
      event.preventDefault();
      show(activeIndex + 1);
    }
  });
  image?.addEventListener(
    "touchstart",
    (event) => {
      touchStartX = event.changedTouches[0]?.clientX;
    },
    { passive: true },
  );
  image?.addEventListener(
    "touchend",
    (event) => {
      const endX = event.changedTouches[0]?.clientX;
      if (touchStartX === undefined || endX === undefined) return;
      const distance = endX - touchStartX;
      if (Math.abs(distance) > 45) show(activeIndex + (distance < 0 ? 1 : -1));
      touchStartX = undefined;
    },
    { passive: true },
  );
</script>

<style>
  .lightbox {
    width: min(96vw, 1500px);
    max-width: none;
    max-height: 96vh;
    padding: 1rem;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--surface) 88%, black);
    color: var(--text);
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 85%);
    backdrop-filter: blur(4px);
  }
  .lightbox-controls {
    display: flex;
    justify-content: flex-end;
  }
  .lightbox-close,
  .lightbox-nav {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    padding: 0;
    border: 1px solid var(--border-card);
    border-radius: 50%;
    background: color-mix(in srgb, var(--surface) 75%, transparent);
    color: var(--text);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
  }
  .lightbox-stage {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 40px;
    gap: 0.75rem;
    align-items: center;
  }
  .lightbox-image {
    display: block;
    width: 100%;
    max-height: 82vh;
    object-fit: contain;
  }
  .lightbox-nav svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lightbox-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .lightbox-footer p {
    margin: 0;
  }
  .lightbox-count {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .inline-lightbox-trigger {
    display: inline-block;
    max-width: 100%;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    cursor: zoom-in;
  }
  .inline-lightbox-trigger img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }
  :global(.prose figure) {
    max-width: 720px;
    margin: 2em auto;
  }
  :global(.prose figure img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }
  :global(.prose figcaption) {
    margin-top: 6px;
    color: var(--muted);
    font-size: 12px;
    text-align: center;
  }
  :global(.prose video),
  :global(.prose audio) {
    display: block;
    width: 100%;
    max-width: 720px;
    margin: 2em auto;
    border-radius: 6px;
    background: var(--media-bg);
  }
  :global(.prose blockquote) {
    margin: 2em 0;
    padding: 0.5rem 1.25rem;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox-image {
      animation: lightbox-in 150ms ease-out;
    }
  }
  @keyframes lightbox-in {
    from {
      opacity: 0.8;
      transform: scale(0.98);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox-image {
      animation: none;
    }
  }
  @media (max-width: 600px) {
    .lightbox {
      padding: 0.5rem;
    }
    .lightbox-stage {
      grid-template-columns: 44px minmax(0, 1fr) 44px;
      gap: 0.25rem;
    }
    .lightbox-close,
    .lightbox-nav {
      width: 44px;
      height: 44px;
    }
  }
</style>

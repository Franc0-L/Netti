---
import "../styles/main.css";
import Lightbox from "../components/Lightbox.astro";

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	ogType?: "website" | "article";
}

const {
	title,
	description = "Reseñas, análisis y noticias de videojuegos.",
	ogImage = "/images/logo-netti.png",
	ogType = "website",
} = Astro.props;

const siteName = "Netti";
const pageTitle =
	title.trim().toLowerCase() === siteName.toLowerCase()
		? siteName
		: `${title} | ${siteName}`;
const canonicalURL = Astro.site
	? new URL(Astro.url.pathname, Astro.site)
	: undefined;
const ogImageURL = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const navItems = [
	{ href: "/juegos/", label: "Juegos" },
	{ href: "/resenas/", label: "Reseñas" },
	{ href: "/noticias/", label: "Noticias" },
];
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#141218" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link
			rel="preload"
			href="/fonts/quicksand-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content="es_AR" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{ogImageURL ? (
			<>
				<meta property="og:image" content={ogImageURL} />
				<meta property="og:image:alt" content={title} />
				<meta property="og:image:width" content="1200" />
				<meta property="og:image:height" content="630" />
				<meta name="twitter:image" content={ogImageURL} />
				<meta name="twitter:image:alt" content={title} />
			</>
		) : null}
		{canonicalURL && <link rel="canonical" href={canonicalURL} />}
		{canonicalURL && <meta property="og:url" content={canonicalURL} />}
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">
			Saltar al contenido
		</a>
		<header class="site-header">
			<a class="brand" href="/" aria-label="Inicio — Netti">
				Netti<span aria-hidden="true">.</span>
			</a>
			<nav aria-label="Navegación principal">
				{navItems.map((item) => (
					<a
						class:list={["btn-3d", { current: isCurrent(item.href) }]}
						href={item.href}
						aria-current={isCurrent(item.href) ? "page" : undefined}
					>
						{item.label}
					</a>
				))}
			</nav>
		</header>
		<main id="main-content" class="container">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					<img
						class="footer-logo"
						src="/images/logo-netti.png"
						alt=""
						width="512"
						height="512"
						loading="lazy"
						decoding="async"
					/>
					<p class="footer-name">
						Netti<span aria-hidden="true">.</span>
					</p>
					<p class="footer-tag">
						Reseñas, fichas y noticias de videojuegos. Hecho para quienes juegan
						<svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
							<path
								fill="var(--red)"
								d="M12 21C3.5 15 2 9.2 5.8 6.3 8.4 4.3 10.8 5.9 12 7.7 13.2 5.9 15.6 4.3 18.2 6.3 22 9.2 20.5 15 12 21Z"
							/>
						</svg>
					</p>
				</div>
				<nav class="footer-col footer-secciones" aria-label="Secciones del sitio">
					<h2 class="footer-heading">Secciones</h2>
					<ul>
						<li>
							<a href="/juegos/">
								<svg
									class="ico ico-cyan"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									aria-hidden="true"
								>
									<path d="M7.5 7h9a5.5 5.5 0 0 1 5.4 6.6l-.8 3.8A2.6 2.6 0 0 1 16.6 18l-1.1-2h-7l-1.1 2a2.6 2.6 0 0 1-4.5-.6l-.8-3.8A5.5 5.5 0 0 1 7.5 7Z" />
									<path d="M8 11v3M6.5 12.5h3" />
									<circle cx="16.2" cy="11.5" r=".9" fill="currentColor" stroke="none" />
									<circle cx="18.6" cy="13.4" r=".9" fill="currentColor" stroke="none" />
								</svg>
								Juegos
							</a>
						</li>
						<li>
							<a href="/resenas/">
								<svg
									class="ico ico-gold"
									viewBox="0 0 24 24"
									fill="currentColor"
									aria-hidden="true"
								>
									<path d="m12 3 2.7 5.7 6.3 .8-4.6 4.3 1.2 6.2-5.6-3-5.6 3 1.2-6.2L3 9.5l6.3-.8Z" />
								</svg>
								Reseñas
							</a>
						</li>
						<li>
							<a href="/noticias/">
								<svg
									class="ico ico-red"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									aria-hidden="true"
								>
									<path d="M4 5h13v14H4Z" />
									<path d="M17 8h3v8a3 3 0 0 1-3 3" />
									<path d="M7 8h7M7 11h7M7 14h4" />
								</svg>
								Noticias
							</a>
						</li>
						<li>
							<a href="/guias/">
								<svg
									class="ico ico-green"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M5 4h6a2 2 0 0 1 2 2v14a3 3 0 0 0-3-3H5V4Z" />
									<path d="M19 4h-6a2 2 0 0 0-2 2v14a3 3 0 0 1 3-3h5V4Z" />
								</svg>
								Guías
							</a>
						</li>
						<li>
							<a href="/buscar/">
								<svg
									class="ico"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.2"
									stroke-linecap="round"
									aria-hidden="true"
								>
									<circle cx="10.5" cy="10.5" r="6.5" />
									<path d="m20 20-4.8-4.8" />
								</svg>
								Buscar
							</a>
						</li>
					</ul>
				</nav>
				<nav class="footer-col" aria-label="Información legal">
					<h2 class="footer-heading">Legal</h2>
					<ul>
						<li>
							<a href="/terminos/">
								<svg
									class="ico ico-muted"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M7 3h7l4 4v14H7Z" />
									<path d="M14 3v4h4" />
									<path d="M10 12h5M10 16h5" />
								</svg>
								Términos y condiciones
							</a>
						</li>
						<li>
							<a href="/privacidad/">
								<svg
									class="ico ico-muted"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3Z" />
								</svg>
								Política de privacidad
							</a>
						</li>
					</ul>
				</nav>
				<div class="footer-col">
					<h2 class="footer-heading">Contacto</h2>
					<ul>
						<li>
							<a class="footer-mail" href="mailto:nettivideojuegos@gmail.com">
								<svg
									viewBox="0 0 24 24"
									width="16"
									height="16"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<rect x="3" y="5" width="18" height="14" rx="3" />
									<path d="m4 7 8 6 8-6" />
								</svg>
								nettivideojuegos@gmail.com
							</a>
						</li>
					</ul>
					<ul class="footer-social">
						<li>
							<a
								href="https://www.youtube.com/@NettiVJ"
								target="_blank"
								rel="noopener noreferrer"
							>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<rect
										x="2.5"
										y="5.5"
										width="19"
										height="13"
										rx="4"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
									/>
									<path d="M10.2 9.2 15.3 12l-5.1 2.8Z" fill="currentColor" />
								</svg>
								YouTube
							</a>
						</li>
						<li>
							<a
								href="https://www.instagram.com/nettivideojuegos"
								target="_blank"
								rel="noopener noreferrer"
							>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									aria-hidden="true"
								>
									<rect x="3.5" y="3.5" width="17" height="17" rx="5" />
									<circle cx="12" cy="12" r="4" />
									<circle
										cx="17"
										cy="7"
										r="1.3"
										fill="currentColor"
										stroke="none"
									/>
								</svg>
								Instagram
							</a>
						</li>
						<li>
							<a
								href="https://www.tiktok.com/@nettivj"
								target="_blank"
								rel="noopener noreferrer"
							>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path
										fill="currentColor"
										d="M14 3h2.3c.3 2 1.7 3.5 3.7 3.7v2.4c-1.4 0-2.7-.4-3.8-1.2v6.9a5.2 5.2 0 1 1-5.2-5.2c.3 0 .7 0 1 .1v2.5a2.7 2.7 0 1 0 1.7 2.5V3Z"
									/>
								</svg>
								TikTok
							</a>
						</li>
					</ul>
				</div>
			</div>
			<p class="footer-legal-bar">
				© {year} {siteName}. Los juegos, marcas y arte mencionados pertenecen a
				sus respectivos estudios y distribuidores.
			</p>
		</footer>
		<Lightbox />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--background: #141218;
		--surface: #1e1b24;
		--surface-raised: #272232;
		--text: #f4effc;
		--muted: #b6adc9;
		--accent: #a78bfa;
		--accent-strong: #c9bbff;
		--accent-deep: #7c3aed;
		--border: #352d45;
		--border-strong: #7c6f99;
		--hairline: rgb(255 255 255 / 8%);
		--field: #17141d;
		--media-bg: #0f0d13;
		--prose: #d2d4dd;
		--on-accent: #17111f;
		--cover-from: #30263f;
		--cover-to: #1b1725;
		--overlay: rgb(10 8 14 / 94%);
		--gold: #e6bd55;
		--red: #f16c79;
		--cyan: #5ac7e8;
		--green: #53bd83;
		--border-card: rgb(167 139 250 / 22%);
		--shadow-hard: 3px 3px 0 rgb(0 0 0 / 24%), 0 0 0 1px rgb(255 255 255 / 4%);
		--shadow-hard-sm:
			2px 2px 0 rgb(0 0 0 / 22%), 0 0 0 1px rgb(255 255 255 / 4%);
		--font-display: "Quicksand", ui-rounded, system-ui, sans-serif;
		--pattern: url("/images/fondo-web.webp");
		font-family:
			"Quicksand",
			ui-rounded,
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;
		font-synthesis: none;
		text-rendering: optimizeLegibility;
	}
	* {
		box-sizing: border-box;
	}
	html {
		background: var(--background);
		scroll-behavior: smooth;
	}
	body {
		min-height: 100vh;
		margin: 0;
		color: var(--text);
		background-color: var(--background);
		background-image:
			linear-gradient(rgb(20 18 24 / 98%), rgb(20 18 24 / 98%)), var(--pattern);
		background-repeat: no-repeat, repeat;
		background-size: auto, 640px 640px;
		line-height: 1.6;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	a:hover {
		color: var(--accent-strong);
	}
	a:focus-visible,
	button:focus-visible,
	input:focus-visible,
	select:focus-visible,
	main:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 6px;
	}
	::selection {
		color: var(--on-accent);
		background: var(--accent);
	}
	.skip-link {
		position: absolute;
		z-index: 10;
		top: 0.75rem;
		left: 0.75rem;
		padding: 0.75rem 1rem;
		transform: translateY(-200%);
		border-radius: 0.6rem;
		color: var(--on-accent);
		background: var(--accent);
		font-weight: 700;
	}
	.skip-link:focus {
		transform: translateY(0);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.container,
	.site-header {
		width: min(1280px, calc(100% - 2.5rem));
		margin-inline: auto;
	}

	.site-header {
		display: grid;
		justify-items: center;
		gap: 1rem;
		padding: clamp(1.75rem, 4vw, 2.75rem) 0 1.1rem;
		text-align: center;
	}
	.brand {
		font-family: var(--font-display);
		font-size: clamp(2.6rem, 7vw, 4.1rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.045em;
		color: #dcddef;
		text-shadow: 2px 2px 0 #462d8f;
	}
	.brand:hover {
		color: #dcddef;
	}
	.brand span {
		color: #8b5cf6;
		text-shadow: 2px 2px 0 #462d8f;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.85rem;
	}
	button:active {
		transform: translateY(1px);
		box-shadow: none;
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-display);
		text-wrap: balance;
		text-shadow: none;
	}
	h1,
	h2 {
		letter-spacing: -0.04em;
	}

	.site-footer {
		margin-top: 4rem;
		border-top: 2px solid var(--border-card);
		background: color-mix(in srgb, var(--surface) 45%, var(--background));
		color: var(--muted);
		font-size: 0.9rem;
	}
	.footer-inner {
		display: grid;
		grid-template-columns: minmax(220px, 1.5fr) repeat(3, minmax(150px, 1fr));
		gap: clamp(1.5rem, 4vw, 3rem);
		width: min(1280px, calc(100% - 2.5rem));
		margin-inline: auto;
		padding: clamp(2rem, 5vw, 3rem) 0 2rem;
	}
	.footer-brand {
		display: grid;
		justify-items: start;
		gap: 0.65rem;
	}
	.footer-logo {
		width: 72px;
		height: 72px;
		border-radius: 50%;
		box-shadow: 3px 4px 0 rgb(70 45 143 / 60%);
	}
	.footer-name {
		margin: 0;
		font-family: var(--font-display);
		font-size: 2.1rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.04em;
		color: #dcddef;
		text-shadow:
			0.045em 0.055em 0 #7c4def,
			0.09em 0.11em 0 #462d8f;
	}
	.footer-name span {
		color: #8b5cf6;
	}
	.footer-tag {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem;
		margin: 0;
		max-width: 32ch;
		line-height: 1.55;
	}
	.footer-col {
		display: block;
	}
	.footer-col ul {
		display: grid;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.footer-secciones ul {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.45rem 1.2rem;
	}
	.site-footer nav a {
		min-height: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		color: var(--muted);
		background: none;
		box-shadow: none;
		font-weight: 400;
	}
	.site-footer nav a:hover,
	.site-footer nav a:active {
		color: var(--accent-strong);
		background: none;
		border-color: transparent;
		transform: none;
		box-shadow: none;
	}
	.footer-heading {
		margin: 0 0 0.85rem;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.footer-col a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--muted);
	}
	.footer-col a:hover {
		color: var(--accent-strong);
	}
	.ico {
		width: 15px;
		height: 15px;
		flex: none;
		color: var(--accent);
	}
	.ico-muted {
		color: var(--muted);
	}
	.ico-cyan {
		color: var(--cyan);
	}
	.ico-gold {
		color: var(--gold);
	}
	.ico-red {
		color: var(--red);
	}
	.ico-green {
		color: var(--green);
	}
	.footer-mail {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}
	.footer-social {
		display: grid;
		gap: 0.55rem;
		margin-top: 0.9rem;
	}
	.footer-social a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.footer-social svg {
		width: 18px;
		height: 18px;
		color: var(--accent);
	}
	.footer-social a:hover {
		color: var(--accent-strong);
	}
	.footer-legal-bar {
		width: min(1280px, calc(100% - 2.5rem));
		margin: 0 auto;
		padding: 0.5rem 0 3rem;
		border-top: 1px solid var(--hairline);
		font-size: 0.78rem;
		text-align: center;
		box-shadow: 0 -2px 5px rgb(0 0 0 / 10%);
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		*,
		*::before,
		*::after {
			scroll-behavior: auto !important;
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
		}
	}
	@media (max-width: 640px) {
		.container,
		.site-header {
			width: min(100% - 1.75rem, 1280px);
		}
		.site-header {
			padding: 1.1rem 0 0.9rem;
			gap: 0.7rem;
		}
		nav {
			gap: 0.5rem;
		}
		nav a {
			padding: 0.45rem 1.05rem;
			font-size: 0.88rem;
		}
		.footer-inner {
			width: min(100% - 1.75rem, 1280px);
		}
		.footer-legal-bar {
			width: min(100% - 1.75rem, 1280px);
		}
	}
	@media (max-width: 860px) {
		.footer-inner {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.footer-brand {
			grid-column: 1 / -1;
			justify-items: center;
			text-align: center;
		}
	}
	@media (max-width: 540px) {
		.footer-inner {
			grid-template-columns: 1fr;
		}
		.footer-col {
			justify-self: center;
			text-align: center;
		}
		.footer-col ul {
			justify-items: center;
		}
	}
</style>
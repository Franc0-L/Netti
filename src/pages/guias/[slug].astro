---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CoverArtwork from "../../components/CoverArtwork.astro";
import MediaGallery from "../../components/MediaGallery.astro";
import MediaVideo from "../../components/MediaVideo.astro";
import { getCollectionEntry } from "../../lib/fetch-content";
import { renderMarkdown } from "../../lib/markdown";
import "../../styles/main.css";

const params = Astro.params as { slug: string };
const item = await getCollectionEntry("guides", params.slug);
if (!item) {
  return Astro.rewrite("/404");
}

const hero = item.data.heroImage ?? item.data.coverImage;
const jsonLd = (value: unknown) =>
  JSON.stringify(value).replace(/</g, "\\u003c");
const ogImage = "/images/logo-netti.png";
const absolute = (path: string) =>
  Astro.site ? new URL(path, Astro.site).href : path;
---

<BaseLayout
  title={item.data.title}
  description={item.data.description}
  ogType="article"
  ogImage={ogImage}
>
  <article class="article guide-article">
    <a class="back-link" href="/guias/">
      ← Todas las guías
    </a>
    <p class="eyebrow">
      Guía ·
      {item.data.publishedAt.toLocaleDateString("es-AR", {
        day: "numeric",
        month: "long",
        year: "numeric",
        timeZone: "UTC",
      })}
    </p>
    <h1>{item.data.title}</h1>
    <p class="lead">{item.data.description}</p>
    <p class="byline">Por {item.data.author}</p>
    {hero && (
      <CoverArtwork
        src={hero}
        alt={item.data.heroAlt ?? item.data.coverAlt ?? item.data.title}
        title={item.data.title}
        variant="hero"
      />
    )}
    <MediaVideo
      url={item.data.videoUrl}
      title={item.data.videoTitle ?? `Video de ${item.data.title}`}
    />
    <div class="prose" set:html={renderMarkdown(item.body)} />
    <MediaGallery items={item.data.gallery} heading="Galería de la guía" />
  </article>

  <script
    is:inline
    type="application/ld+json"
    set:html={jsonLd({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: item.data.title,
      description: item.data.description,
      datePublished: item.data.publishedAt.toISOString(),
      dateModified: (
        item.data.updatedAt ?? item.data.publishedAt
      ).toISOString(),
      author: { "@type": "Person", name: item.data.author },
      publisher: { "@type": "Organization", name: "Netti" },
      image: absolute(ogImage),
    })}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={jsonLd({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Inicio",
          item: absolute("/"),
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guías",
          item: absolute("/guias/"),
        },
        {
          "@type": "ListItem",
          position: 3,
          name: item.data.title,
          item: absolute(`/guias/${item.id}/`),
        },
      ],
    })}
  />
</BaseLayout>

<style>
  .guide-article {
    max-width: 1280px;
  }
  h1 {
    max-width: 900px;
    margin: 0.5rem 0 1rem;
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: -0.06em;
    text-wrap: balance;
  }
  .lead {
    max-width: 780px;
    line-height: 1.8;
  }
  .byline {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .article :global(.cover) {
    margin: 2rem 0;
    border-radius: 1rem;
  }
  .prose {
    max-width: 68ch;
    margin: 2rem auto;
    font-size: 1.06rem;
    line-height: 1.9;
  }
  .prose :global(p) {
    color: var(--prose);
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

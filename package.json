{
  "name": "netti",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Blog de videojuegos con Astro SSR y panel editorial propio",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "npx --yes tsx scripts/content-validator.ts",
    "audit:media": "npx --yes tsx scripts/media-audit.ts",
    "test:admin-preview": "node --test tests/admin-markdown-preview.test.mjs tests/admin-html-safety.test.mjs tests/admin-api-client.test.mjs tests/admin-list-views.test.mjs"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/vercel": "^11.0.17",
    "astro": "^7.4.2",
    "marked": "^18.1.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/sitemap": "^3.2.1",
    "@axe-core/webdriverjs": "^4.14.0",
    "@types/node": "^22.0.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.0.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "postcss-selector-parser": "^7.1.6",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}

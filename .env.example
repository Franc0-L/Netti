# Copy to .env.local and replace every example value.
# Never commit .env.local or production credentials.

DATABASE_URL=postgresql://netti:netti@localhost:5432/netti
DATABASE_URL_UNPOOLED=postgresql://netti:netti@localhost:5432/netti
DATABASE_POOL_MAX=2

# Placeholder only. Generate a real scrypt hash before enabling editorial login.
ADMIN_PASSWORD_HASH=scrypt:131072:8:1:REPLACE_WITH_SALT_BASE64:REPLACE_WITH_HASH_BASE64

# Use a real Vercel Blob read/write token in environments that upload media.
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token

# Generate at least 32 random bytes for scheduled endpoints.
CRON_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_SITE_URL=http://localhost:3000